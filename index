<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Roomie - Shared Living Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            warm: {
              50: '#fdfbf7',
              100: '#f7f3eb',
              200: '#ede6d8',
              300: '#dfd4c0',
              400: '#c4b397',
              500: '#a38f72',
              600: '#857156',
              700: '#685642',
              800: '#483c2e',
              900: '#2b231b',
            },
            terracotta: {
              50: '#fdf6f3',
              100: '#fbe9e3',
              500: '#e07a5f',
              600: '#cb6043',
              700: '#a8472d',
            },
            sage: {
              50: '#f3f7f4',
              100: '#e3eee6',
              500: '#81b29a',
              600: '#61967c',
              700: '#487560',
            },
            homeDark: '#2d3142'
          }
        }
      }
    }
  </script>
  <style>
    body { background-color: #f7f3eb; color: #2d3142; font-family: 'Plus Jakarta Sans', sans-serif; }
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #dfd4c0; border-radius: 9999px; }
  </style>
</head>
<body class="antialiased min-h-screen">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useMemo } = React;

    // --- SVG ICONS ---
    const IconCheck = () => (<svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2.5" d="M5 13l4 4L19 7"/></svg>);
    const IconPlus = () => (<svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 4v16m8-8H4"/></svg>);
    const IconHome = () => (<svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>);
    const IconTasks = () => (<svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>);
    const IconExpenses = () => (<svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V6m0 12v-2m0 0e1.11 0 2.08-.402 2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>);
    const IconActivity = () => (<svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>);
    const IconUsers = () => (<svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>);
    const IconAlert = () => (<svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>);
    const IconClock = () => (<svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>);
    const IconCopy = () => (<svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>);
    const IconTrash = () => (<svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>);

    // --- MOCK INITIAL SEED DATA ---
    const INITIAL_USERS = [
      { id: 'u1', name: 'Alex Chen', email: 'alex@roomie.app', avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80', role: 'Organizer' },
      { id: 'u2', name: 'Jordan Smith', email: 'jordan@roomie.app', avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&auto=format&fit=crop&q=80', role: 'Member' },
      { id: 'u3', name: 'Sam Miller', email: 'sam@roomie.app', avatar: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&auto=format&fit=crop&q=80', role: 'Member' },
      { id: 'u4', name: 'Taylor Reed', email: 'taylor@roomie.app', avatar: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100&auto=format&fit=crop&q=80', role: 'Member' }
    ];

    const TODAY = new Date().toISOString().split('T')[0];
    const YESTERDAY = new Date(Date.now() - 86400000).toISOString().split('T')[0];
    const TOMORROW = new Date(Date.now() + 86400000).toISOString().split('T')[0];

    const INITIAL_HOUSEHOLD = {
      id: 'hh1',
      name: 'Apt 4B - Oak Street',
      inviteCode: 'OAK-4B92'
    };

    const INITIAL_TASKS = [
      { id: 't1', title: 'Buy toilet paper & paper towels', description: 'Get 12-pack from Costco if possible', assignedTo: 'u1', dueDate: TODAY, status: 'in_progress', createdBy: 'u2', createdAt: YESTERDAY },
      { id: 't2', title: 'Take out recycling and compost', description: 'Pickup is early Tuesday morning', assignedTo: 'u2', dueDate: YESTERDAY, status: 'todo', createdBy: 'u1', createdAt: YESTERDAY },
      { id: 't3', title: 'Deep clean kitchen counters & sink', description: 'Sanitize stove top and empty dish rack', assignedTo: 'u3', dueDate: TOMORROW, status: 'todo', createdBy: 'u1', createdAt: TODAY },
      { id: 't4', title: 'Pay monthly Wi-Fi & Internet bill', description: 'Fios 1Gbps plan ($80 total)', assignedTo: 'u4', dueDate: YESTERDAY, status: 'completed', createdBy: 'u4', createdAt: YESTERDAY }
    ];

    const INITIAL_EXPENSES = [
      { id: 'e1', description: 'Trader Joe\'s Household Grocery', amount: 84.00, paidBy: 'u1', date: TODAY, participants: ['u1', 'u2', 'u3', 'u4'], createdAt: TODAY },
      { id: 'e2', description: 'ConEd Electricity Bill', amount: 120.00, paidBy: 'u2', date: YESTERDAY, participants: ['u1', 'u2', 'u3'], createdAt: YESTERDAY },
      { id: 'e3', description: 'Trash Bags & Dish Soap', amount: 18.50, paidBy: 'u3', date: YESTERDAY, participants: ['u1', 'u2', 'u3', 'u4'], createdAt: YESTERDAY }
    ];

    const INITIAL_ACTIVITIES = [
      { id: 'a1', actorId: 'u4', actionType: 'TASK_COMPLETED', title: 'completed "Pay monthly Wi-Fi & Internet bill"', timestamp: '2 hours ago' },
      { id: 'a2', actorId: 'u1', actionType: 'EXPENSE_ADDED', title: 'recorded expense "Trader Joe\'s Household Grocery" ($84.00)', timestamp: '4 hours ago' },
      { id: 'a3', actorId: 'u1', actionType: 'TASK_CREATED', title: 'created task "Deep clean kitchen counters & sink"', timestamp: '1 day ago' },
      { id: 'a4', actorId: 'u2', actionType: 'EXPENSE_ADDED', title: 'recorded expense "ConEd Electricity Bill" ($120.00)', timestamp: '2 days ago' }
    ];

    // --- MAIN APP COMPONENT ---
    function App() {
      // Load or Initialize State
      const [household, setHousehold] = useState(() => JSON.parse(localStorage.getItem('rm_hh')) || INITIAL_HOUSEHOLD);
      const [users, setUsers] = useState(() => JSON.parse(localStorage.getItem('rm_users')) || INITIAL_USERS);
      const [currentUser, setCurrentUser] = useState(() => users[0]);
      const [tasks, setTasks] = useState(() => JSON.parse(localStorage.getItem('rm_tasks')) || INITIAL_TASKS);
      const [expenses, setExpenses] = useState(() => JSON.parse(localStorage.getItem('rm_expenses')) || INITIAL_EXPENSES);
      const [activities, setActivities] = useState(() => JSON.parse(localStorage.getItem('rm_act')) || INITIAL_ACTIVITIES);
      const [activeTab, setActiveTab] = useState('dashboard');

      // Modals
      const [isAddTaskOpen, setIsAddTaskOpen] = useState(false);
      const [isAddExpenseOpen, setIsAddExpenseOpen] = useState(false);
      const [isJoinHouseholdOpen, setIsJoinHouseholdOpen] = useState(false);
      const [toastMsg, setToastMsg] = useState(null);

      // Save to localStorage
      useEffect(() => { localStorage.setItem('rm_hh', JSON.stringify(household)); }, [household]);
      useEffect(() => { localStorage.setItem('rm_users', JSON.stringify(users)); }, [users]);
      useEffect(() => { localStorage.setItem('rm_tasks', JSON.stringify(tasks)); }, [tasks]);
      useEffect(() => { localStorage.setItem('rm_expenses', JSON.stringify(expenses)); }, [expenses]);
      useEffect(() => { localStorage.setItem('rm_act', JSON.stringify(activities)); }, [activities]);

      const showToast = (msg) => {
        setToastMsg(msg);
        setTimeout(() => setToastMsg(null), 3000);
      };

      const logActivity = (actionType, titleText) => {
        const newAct = {
          id: 'a_' + Date.now(),
          actorId: currentUser.id,
          actionType,
          title: titleText,
          timestamp: 'Just now'
        };
        setActivities(prev => [newAct, ...prev]);
      };

      const resetDemoData = () => {
        setHousehold(INITIAL_HOUSEHOLD);
        setUsers(INITIAL_USERS);
        setCurrentUser(INITIAL_USERS[0]);
        setTasks(INITIAL_TASKS);
        setExpenses(INITIAL_EXPENSES);
        setActivities(INITIAL_ACTIVITIES);
        showToast('Demo data restored!');
      };

      // Financial Calculation Engine
      const expenseSummary = useMemo(() => {
        const totalSpent = expenses.reduce((acc, curr) => acc + curr.amount, 0);
        
        // Calculate balance for each user: Total Paid - Total Share Owed
        const userBalances = {};
        users.forEach(u => { userBalances[u.id] = 0; });

        expenses.forEach(e => {
          const splitAmount = e.amount / (e.participants.length || 1);
          // Credit payer
          if (userBalances[e.paidBy] !== undefined) {
            userBalances[e.paidBy] += e.amount;
          }
          // Debit participants
          e.participants.forEach(pId => {
            if (userBalances[pId] !== undefined) {
              userBalances[pId] -= splitAmount;
            }
          });
        });

        return { totalSpent, userBalances };
      }, [expenses, users]);

      const overdueTasksCount = useMemo(() => {
        return tasks.filter(t => t.dueDate < TODAY && t.status !== 'completed').length;
      }, [tasks]);

      return (
        <div className="flex flex-col min-h-screen">
          {/* Toast Notification */}
          {toastMsg && (
            <div className="fixed top-4 right-4 z-50 bg-homeDark text-white px-4 py-3 rounded-xl shadow-lg border border-warm-700 flex items-center space-x-2 animate-bounce">
              <IconCheck />
              <span className="text-sm font-medium">{toastMsg}</span>
            </div>
          )}

          {/* Top Bar Header */}
          <header className="bg-white border-b border-warm-200 sticky top-0 z-30">
            <div className="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between">
              {/* Brand & Household Switcher */}
              <div className="flex items-center space-x-4">
                <div className="flex items-center space-x-2">
                  <div className="w-9 h-9 rounded-xl bg-terracotta-500 flex items-center justify-center text-white font-bold text-lg shadow-sm">
                    R
                  </div>
                  <div>
                    <h1 className="font-bold text-lg text-homeDark leading-tight">{household.name}</h1>
                    <div className="flex items-center space-x-2 text-xs text-warm-600">
                      <span>Code: <strong className="font-semibold text-warm-800">{household.inviteCode}</strong></span>
                      <button 
                        onClick={() => {
                          navigator.clipboard.writeText(household.inviteCode);
                          showToast('Invite code copied!');
                        }} 
                        className="hover:text-terracotta-600 transition" 
                        title="Copy Code"
                      >
                        <IconCopy />
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              {/* Active User Simulation Switcher */}
              <div className="flex items-center space-x-3">
                <div className="hidden md:flex items-center space-x-2 bg-warm-100 px-3 py-1.5 rounded-full border border-warm-200">
                  <span className="text-xs text-warm-600 font-medium">Viewing as:</span>
                  <select 
                    value={currentUser.id}
                    onChange={(e) => setCurrentUser(users.find(u => u.id === e.target.value))}
                    className="bg-transparent text-xs font-semibold text-homeDark focus:outline-none cursor-pointer"
                  >
                    {users.map(u => (
                      <option key={u.id} value={u.id}>{u.name} ({u.role})</option>
                    ))}
                  </select>
                </div>
                
                <button 
                  onClick={resetDemoData} 
                  className="text-xs text-warm-600 hover:text-warm-900 border border-warm-300 hover:border-warm-400 bg-white px-3 py-1.5 rounded-lg transition"
                >
                  Reset Demo
                </button>
              </div>
            </div>

            {/* Navigation Tabs */}
            <div className="max-w-6xl mx-auto px-4 sm:px-6 flex space-x-1 border-t border-warm-100 overflow-x-auto custom-scrollbar">
              <NavTab id="dashboard" label="Dashboard" icon={<IconHome />} activeTab={activeTab} setActiveTab={setActiveTab} badge={overdueTasksCount ? `${overdueTasksCount} overdue` : null} badgeColor="bg-terracotta-500 text-white" />
              <NavTab id="tasks" label="Tasks & Chores" icon={<IconTasks />} activeTab={activeTab} setActiveTab={setActiveTab} />
              <NavTab id="expenses" label="Expenses" icon={<IconExpenses />} activeTab={activeTab} setActiveTab={setActiveTab} />
              <NavTab id="activity" label="Activity Feed" icon={<IconActivity />} activeTab={activeTab} setActiveTab={setActiveTab} />
              <NavTab id="household" label="Household" icon={<IconUsers />} activeTab={activeTab} setActiveTab={setActiveTab} />
            </div>
          </header>

          {/* Main Body */}
          <main className="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-6">
            {activeTab === 'dashboard' && (
              <DashboardView 
                household={household}
                currentUser={currentUser}
                users={users}
                tasks={tasks}
                expenses={expenses}
                activities={activities}
                expenseSummary={expenseSummary}
                setTasks={setTasks}
                logActivity={logActivity}
                showToast={showToast}
                openAddTask={() => setIsAddTaskOpen(true)}
                openAddExpense={() => setIsAddExpenseOpen(true)}
                setActiveTab={setActiveTab}
              />
            )}

            {activeTab === 'tasks' && (
              <TasksView 
                tasks={tasks}
                setTasks={setTasks}
                users={users}
                currentUser={currentUser}
                logActivity={logActivity}
                showToast={showToast}
                openAddTask={() => setIsAddTaskOpen(true)}
              />
            )}

            {activeTab === 'expenses' && (
              <ExpensesView 
                expenses={expenses}
                setExpenses={setExpenses}
                users={users}
                currentUser={currentUser}
                expenseSummary={expenseSummary}
                logActivity={logActivity}
                showToast={showToast}
                openAddExpense={() => setIsAddExpenseOpen(true)}
              />
            )}

            {activeTab === 'activity' && (
              <ActivityView activities={activities} users={users} />
            )}

            {activeTab === 'household' && (
              <HouseholdView 
                household={household}
                users={users}
                setHousehold={setHousehold}
                setUsers={setUsers}
                showToast={showToast}
                openJoinModal={() => setIsJoinHouseholdOpen(true)}
              />
            )}
          </main>

          {/* Modals */}
          {isAddTaskOpen && (
            <AddTaskModal 
              users={users} 
              currentUser={currentUser} 
              onClose={() => setIsAddTaskOpen(false)}
              onAdd={(newTask) => {
                setTasks(prev => [newTask, ...prev]);
                logActivity('TASK_CREATED', `created task "${newTask.title}"`);
                showToast('Task added successfully!');
                setIsAddTaskOpen(false);
              }}
            />
          )}

          {isAddExpenseOpen && (
            <AddExpenseModal 
              users={users} 
              currentUser={currentUser} 
              onClose={() => setIsAddExpenseOpen(false)}
              onAdd={(newExp) => {
                setExpenses(prev => [newExp, ...prev]);
                logActivity('EXPENSE_ADDED', `recorded expense "${newExp.description}" ($${newExp.amount.toFixed(2)})`);
                showToast('Expense recorded!');
                setIsAddExpenseOpen(false);
              }}
            />
          )}

          {isJoinHouseholdOpen && (
            <JoinHouseholdModal 
              onClose={() => setIsJoinHouseholdOpen(false)}
              onJoin={(hhName) => {
                setHousehold({ id: 'hh_' + Date.now(), name: hhName, inviteCode: 'JOIN-' + Math.floor(1000 + Math.random() * 9000) });
                showToast(`Switched to household "${hhName}"`);
                setIsJoinHouseholdOpen(false);
              }}
            />
          )}
        </div>
      );
    }

    // --- NAVIGATION TAB ITEM ---
    function NavTab({ id, label, icon, activeTab, setActiveTab, badge, badgeColor }) {
      const active = activeTab === id;
      return (
        <button
          onClick={() => setActiveTab(id)}
          className={`flex items-center space-x-2 py-3 px-4 text-sm font-medium border-b-2 transition whitespace-nowrap ${
            active 
              ? 'border-terracotta-500 text-terracotta-600 font-semibold' 
              : 'border-transparent text-warm-600 hover:text-warm-900 hover:border-warm-300'
          }`}
        >
          {icon}
          <span>{label}</span>
          {badge && (
            <span className={`text-[10px] font-bold px-1.5 py-0.5 rounded-full ${badgeColor || 'bg-warm-200 text-warm-800'}`}>
              {badge}
            </span>
          )}
        </button>
      );
    }

    // --- DASHBOARD VIEW ---
    function DashboardView({ household, currentUser, users, tasks, expenses, activities, expenseSummary, setTasks, logActivity, showToast, openAddTask, openAddExpense, setActiveTab }) {
      const myTasks = tasks.filter(t => t.assignedTo === currentUser.id && t.status !== 'completed');
      const overdueTasks = tasks.filter(t => t.dueDate < TODAY && t.status !== 'completed');
      const myBalance = expenseSummary.userBalances[currentUser.id] || 0;

      const toggleTaskStatus = (task) => {
        const nextStatus = task.status === 'completed' ? 'todo' : 'completed';
        setTasks(prev => prev.map(t => t.id === task.id ? { ...t, status: nextStatus } : t));
        if (nextStatus === 'completed') {
          logActivity('TASK_COMPLETED', `completed "${task.title}"`);
          showToast('Marked task completed!');
        }
      };

      return (
        <div className="space-y-6">
          {/* Overdue Alert Banner if present */}
          {overdueTasks.length > 0 && (
            <div className="bg-terracotta-50 border border-terracotta-100 rounded-2xl p-4 flex items-center justify-between">
              <div className="flex items-center space-x-3">
                <div className="p-2 bg-terracotta-500 text-white rounded-xl">
                  <IconAlert />
                </div>
                <div>
                  <p className="text-sm font-semibold text-terracotta-700">
                    {overdueTasks.length} {overdueTasks.length === 1 ? 'task requires' : 'tasks require'} immediate attention
                  </p>
                  <p className="text-xs text-terracotta-600">Help keep the household running smoothly!</p>
                </div>
              </div>
              <button 
                onClick={() => setActiveTab('tasks')}
                className="text-xs font-semibold bg-terracotta-500 hover:bg-terracotta-600 text-white px-3.5 py-2 rounded-xl transition"
              >
                View Overdue
              </button>
            </div>
          )}

          {/* Quick Action Grid */}
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div className="bg-white p-5 rounded-2xl border border-warm-200 shadow-sm flex flex-col justify-between">
              <div>
                <span className="text-xs font-medium text-warm-600 uppercase tracking-wider">Your Balance</span>
                <div className="mt-2 flex items-baseline space-x-2">
                  <span className={`text-2xl font-bold ${myBalance >= 0 ? 'text-sage-600' : 'text-terracotta-600'}`}>
                    {myBalance >= 0 ? `+$${myBalance.toFixed(2)}` : `-$${Math.abs(myBalance).toFixed(2)}`}
                  </span>
                  <span className="text-xs text-warm-600">
                    {myBalance >= 0 ? 'you are owed' : 'you owe'}
                  </span>
                </div>
              </div>
              <button 
                onClick={openAddExpense} 
                className="mt-4 inline-flex items-center justify-center space-x-1.5 w-full bg-warm-100 hover:bg-warm-200 text-warm-800 text-xs font-semibold py-2 px-3 rounded-xl transition"
              >
                <IconPlus />
                <span>Record Expense</span>
              </button>
            </div>

            <div className="bg-white p-5 rounded-2xl border border-warm-200 shadow-sm flex flex-col justify-between">
              <div>
                <span className="text-xs font-medium text-warm-600 uppercase tracking-wider">Your Responsibilities</span>
                <div className="mt-2 flex items-baseline space-x-2">
                  <span className="text-2xl font-bold text-homeDark">{myTasks.length}</span>
                  <span className="text-xs text-warm-600">pending tasks assigned to you</span>
                </div>
              </div>
              <button 
                onClick={openAddTask} 
                className="mt-4 inline-flex items-center justify-center space-x-1.5 w-full bg-terracotta-500 hover:bg-terracotta-600 text-white text-xs font-semibold py-2 px-3 rounded-xl transition shadow-sm"
              >
                <IconPlus />
                <span>Create New Task</span>
              </button>
            </div>

            <div className="bg-white p-5 rounded-2xl border border-warm-200 shadow-sm flex flex-col justify-between">
              <div>
                <span className="text-xs font-medium text-warm-600 uppercase tracking-wider">Household Total Spend</span>
                <div className="mt-2 flex items-baseline space-x-2">
