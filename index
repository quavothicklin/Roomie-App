                  const isOverdue = t.dueDate < TODAY && t.status !== 'completed';

                  return (
                    <div key={t.id} className="p-4 hover:bg-warm-50/50 transition flex items-center justify-between space-x-4">
                      <div className="flex items-start space-x-3.5">
