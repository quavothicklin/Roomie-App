    // --- ADD EXPENSE MODAL ---
    function AddExpenseModal({ users, currentUser, onClose, onAdd }) {
      const [description, setDescription] = useState('');
      const [amount, setAmount] = useState('');
      const [paidBy, setPaidBy] = useState(currentUser.id);
      const [participants, setParticipants] = useState(users.map(u => u.id));

      const toggleParticipant = (uId) => {
        if (participants.includes(uId)) {
          if (participants.length === 1) return; // Keep at least 1
          setParticipants(participants.filter(id => id !== uId));
        } else {
          setParticipants([...participants, uId]);
        }
      };

      const handleSubmit = (e) => {
        e.preventDefault();
        const numAmount = parseFloat(amount);
        if (!description.trim() || isNaN(numAmount) || numAmount <= 0) return;

        onAdd({
          id: 'e_' + Date.now(),
          description,
          amount: numAmount,
          paidBy,
          date: TODAY,
          participants,
          createdAt: TODAY
        });
      };

      const calculatedSplit = amount && !isNaN(parseFloat(amount)) ? (parseFloat(amount) / participants.length).toFixed(2) : '0.00';

      return (
        <div className="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div className="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-warm-200">
            <h3 className="text-lg font-bold text-homeDark mb-4">Record Shared Purchase</h3>
            <form onSubmit={handleSubmit} className="space-y-4">
              <div>
                <label className="block text-xs font-semibold text-warm-700 mb-1">Description *</label>
                <input 
                  type="text" 
                  required
                  placeholder="e.g., Grocery run, Internet bill" 
                  value={description}
                  onChange={e => setDescription(e.target.value)}
                  className="w-full text-sm px-3 py-2 rounded-xl border border-warm-200 focus:outline-none focus:border-terracotta-500"
                />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-xs font-semibold text-warm-700 mb-1">Amount ($) *</label>
                  <input 
                    type="number" 
                    step="0.01"
                    required
                    placeholder="0.00" 
                    value={amount}
                    onChange={e => setAmount(e.target.value)}
                    className="w-full text-sm px-3 py-2 rounded-xl border border-warm-200 focus:outline-none focus:border-terracotta-500"
                  />
                </div>

                <div>
                  <label className="block text-xs font-semibold text-warm-700 mb-1">Paid By</label>
                  <select 
                    value={paidBy}
                    onChange={e => setPaidBy(e.target.value)}
                    className="w-full text-xs px-3 py-2 rounded-xl border border-warm-200 focus:outline-none"
                  >
                    {users.map(u => (
                      <option key={u.id} value={u.id}>{u.name}</option>
                    ))}
                  </select>
                </div>
              </div>

              <div>
                <label className="block text-xs font-semibold text-warm-700 mb-2">
                  Split Equally Among ({participants.length} roommates • ${calculatedSplit}/ea)
                </label>
                <div className="space-y-2 max-h-36 overflow-y-auto custom-scrollbar border border-warm-100 p-2 rounded-xl bg-warm-50">
                  {users.map(u => (
                    <label key={u.id} className="flex items-center space-x-2 text-xs font-medium text-homeDark cursor-pointer">
                      <input 
                        type="checkbox" 
                        checked={participants.includes(u.id)}
                        onChange={() => toggleParticipant(u.id)}
                        className="rounded border-warm-300 text-terracotta-500 focus:ring-terracotta-500"
                      />
                      <span>{u.name}</span>
                    </label>
                  ))}
                </div>
              </div>

              <div className="pt-3 flex justify-end space-x-2">
                <button type="button" onClick={onClose} className="px-4 py-2 rounded-xl text-xs font-semibold text-warm-600 hover:bg-warm-100">
                  Cancel
                </button>
                <button type="submit" className="px-4 py-2 rounded-xl text-xs font-semibold bg-terracotta-500 hover:bg-terracotta-600 text-white shadow-sm">
                  Record Expense
                </button>
              </div>
            </form>
          </div>
        </div>
      );
    }

    // --- JOIN HOUSEHOLD MODAL ---
    function JoinHouseholdModal({ onClose, onJoin }) {
      const [name, setName] = useState('');

      const handleSubmit = (e) => {
        e.preventDefault();
        if (!name.trim()) return;
        onJoin(name);
      };

      return (
        <div className="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div className="bg-white rounded-2xl max-w-sm w-full p-6 shadow-xl border border-warm-200">
            <h3 className="text-lg font-bold text-homeDark mb-2">Create / Switch Household</h3>
            <p className="text-xs text-warm-600 mb-4">Enter a new household name or enter an invite code to join existing.</p>
            <form onSubmit={handleSubmit} className="space-y-4">
              <div>
                <label className="block text-xs font-semibold text-warm-700 mb-1">Household Name or Code</label>
                <input 
                  type="text" 
                  required
                  placeholder="e.g., Apt 2B or OAK-4B92" 
                  value={name}
                  onChange={e => setName(e.target.value)}
                  className="w-full text-sm px-3 py-2 rounded-xl border border-warm-200 focus:outline-none focus:border-terracotta-500"
                />
              </div>

              <div className="pt-2 flex justify-end space-x-2">
                <button type="button" onClick={onClose} className="px-4 py-2 rounded-xl text-xs font-semibold text-warm-600 hover:bg-warm-100">
                  Cancel
                </button>
                <button type="submit" className="px-4 py-2 rounded-xl text-xs font-semibold bg-terracotta-500 hover:bg-terracotta-600 text-white shadow-sm">
                  Switch Household
                </button>
              </div>
            </form>
          </div>
        </div>
      );
    }

    // Render App
    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
