                <button
                  key={f}
                  onClick={() => setFilter(f)}
                  className={`px-3 py-1.5 rounded-xl text-xs font-semibold capitalize transition ${
                    filter === f ? 'bg-homeDark text-white' : 'bg-warm-100 text-warm-700 hover:bg-warm-200'
